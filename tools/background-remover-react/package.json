{
  "name": "codexpro-background-remover",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5190 && cross-env BG_REMOVER_DEV_URL=http://127.0.0.1:5190 electron .\"",
    "build": "vite build",
    "pack:mac": "npm run build && electron-builder --mac dir --arm64"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "store.muatenmien.codexpro.background-remover",
    "productName": "CodexPro Background Remover",
    "artifactName": "CodexPro-Xoa-Nen-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": ["png", "jpg", "jpeg", "gif", "webp"],
        "name": "Image",
        "role": "Editor"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "electron/remove_background_ai.py"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": "dir"
    }
  }
}
