{
  "manifest_version": 3,
  "name": "CodexPro Local Source Reader",
  "version": "0.3.2",
  "description": "Upload full or changed local source snapshots, advance baseline only after ChatGPT network confirmation, keep re-uploadable history, and persist upload diagnostics.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "upload-network.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js",
        "diagnostics-ui.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
