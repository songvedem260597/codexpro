{
  "name": "codexpro",
  "version": "0.29.4",
  "description": "A local MCP/App SDK-style connector that lets ChatGPT inspect, edit, and hand off work to Codex inside a local dev workspace.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rebel0789/codexpro.git"
  },
  "bugs": {
    "url": "https://github.com/rebel0789/codexpro/issues"
  },
  "homepage": "https://rebel0789.github.io/codexpro/",
  "keywords": [
    "mcp",
    "chatgpt",
    "codex",
    "apps-sdk",
    "codexpro",
    "local-development",
    "cloudflare-tunnel",
    "ngrok",
    "tailscale"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs/index.html",
    "docs/zh.html",
    "docs/styles.css",
    "docs/script.js",
    "docs/favicon.svg",
    "docs/og.svg",
    "docs/star.svg",
    "docs/images",
    "chrome-extension",
    ".opencode",
    "scripts",
    "README.md",
    "README_ZH.md",
    "PUBLIC_LAUNCH_CHECKLIST.md",
    "DOMAIN_SETUP.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "FAQ.md",
    "FAQ_ZH.md",
    "CHANGELOG.md",
    "CHATGPT_PROMPT.md",
    "CODEX_PROMPT.md",
    "AGENTS.example.md",
    "config.example.env"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "codexpro": "scripts/codexpro.mjs",
    "codexpro-mcp": "dist/stdio.js",
    "codexpro-mcp-http": "dist/http.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/release-guard.mjs",
    "start": "node dist/stdio.js",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "smoke": "node scripts/domless-send-smoke.mjs && node scripts/browser-agent-smoke.mjs && node scripts/network-stream-capture-smoke.mjs && node scripts/git-write-policy-smoke.mjs && node scripts/analysis-smoke.mjs && node scripts/codexgraph-smoke.mjs && node scripts/runtime-trace-smoke.mjs && node scripts/runtime-trace-mcp-smoke.mjs && node scripts/analysis-cli-smoke.mjs && node scripts/smoke.mjs && node scripts/usage-log-smoke.mjs && node scripts/skill-precedence-smoke.mjs && node scripts/http-smoke.mjs && node scripts/widget-smoke.mjs && node scripts/pro-smoke.mjs && node scripts/doctor-smoke.mjs && node scripts/settings-smoke.mjs && node scripts/opencode-subagent-smoke.mjs && node scripts/native-audit-smoke.mjs && node scripts/execute-handoff-smoke.mjs && node scripts/release-guard-smoke.mjs",
    "subagent:live": "node scripts/opencode-subagent-live-smoke.mjs",
    "audit:live": "node scripts/native-audit-live-smoke.mjs",
    "browser:e2e": "node scripts/browser-agent-live-e2e.mjs",
    "stress": "npm run build && node scripts/stress.mjs",
    "analysis:smoke": "npm run build && node scripts/analysis-smoke.mjs",
    "codexgraph:smoke": "npm run build && node scripts/codexgraph-smoke.mjs",
    "runtime-trace:smoke": "npm run build && node scripts/runtime-trace-smoke.mjs && node scripts/runtime-trace-mcp-smoke.mjs",
    "analysis:cli-smoke": "npm run build && node scripts/analysis-cli-smoke.mjs",
    "doctor": "node scripts/codexpro.mjs doctor",
    "windows:recover": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-recover.ps1 -StartNow",
    "manager:dev": "npm --prefix manager run dev",
    "manager:build": "npm --prefix manager run build",
    "manager:check": "npm --prefix manager run build && npm --prefix manager run test:markdown",
    "manager:dist": "npm --prefix manager run dist",
    "connect": "node scripts/codexpro.mjs",
    "connect:setup": "node scripts/codexpro.mjs setup",
    "connect:local": "node scripts/codexpro.mjs --tunnel none",
    "connect:cloudflare": "node scripts/codexpro.mjs --tunnel cloudflare",
    "connect:chatgpt": "node scripts/codexpro.mjs --tunnel cloudflare",
    "connect:stable": "node scripts/codexpro.mjs --tunnel cloudflare-named",
    "connect:ngrok": "node scripts/codexpro.mjs ngrok",
    "connect:tailscale": "node scripts/codexpro.mjs tailscale",
    "pro:bundle": "node scripts/pro-bundle.mjs",
    "pro:apply": "node scripts/pro-apply.mjs",
    "release:guard": "node scripts/release-guard.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "release:check": "npm run release:guard && npm run build && npm run manager:check && npm run smoke && npm run stress && npm audit --audit-level=high && npm run release:pack",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "minimatch": "^10.0.1",
    "typescript": "^5.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3"
  }
}
