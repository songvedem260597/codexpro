{
  "manifest_version": 3,
  "name": "CodexPro Profile Bridge",
  "version": "0.1.0",
  "description": "Lets CodexPro control only the Chrome profile marked ACTIVE.",
  "permissions": ["tabs", "scripting", "debugger", "identity", "identity.email", "storage", "alarms"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:9224/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "CodexPro Profile Bridge",
    "default_popup": "popup.html"
  }
}
