{
  "manifest_version": 3,
  "name": "CodexPro Profile Bridge",
  "version": "0.5.84",
  "key": "",
  "description": "Adds CodexPro to ChatGPT automatically and controls only the Chrome profile marked ACTIVE.",
  "permissions": ["tabs", "scripting", "identity", "identity.email", "storage", "alarms", "webRequest", "debugger"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:9224/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["network-capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["connector-installer.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CodexPro Profile Bridge",
    "default_popup": "popup.html"
  }
}
