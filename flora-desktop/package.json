{
  "name": "flora-desktop-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop FLORA image generator using a user-authenticated FLORA session.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.flora.desktop.generator",
    "productName": "FLORA Desktop Generator",
    "artifactName": "FLORA-Desktop-Generator-${version}.${ext}",
    "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs", "renderer.js", "index.html", "styles.css", "package.json"],
    "asar": true,
    "win": { "target": ["portable"] }
  }
}
