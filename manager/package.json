{
  "name": "codexpro-manager",
  "version": "0.3.4",
  "private": true,
  "description": "Desktop manager for a local CodexPro MCP server on macOS and Windows.",
  "author": "CodexPro contributors",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env CODEXPRO_MANAGER_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "test:markdown": "node scripts/markdown-response-smoke.mjs",
    "test:worker-packs": "node scripts/worker-pack-assets-smoke.mjs",
    "test:diagnostic": "node scripts/diagnostic-log-smoke.mjs && node scripts/runtime-health-diagnostic-smoke.mjs && node scripts/operations-metrics-smoke.mjs",
    "test:chat-composer": "node scripts/chat-composer-isolation-smoke.mjs",
    "test:runtime-restart": "node scripts/runtime-restart-send-race-smoke.mjs",
    "test:api-worker-form": "node scripts/api-worker-form-smoke.mjs",
    "test:api-worker-models": "node scripts/api-worker-model-discovery-smoke.mjs",
    "test:connected-workers": "node scripts/ui-performance-smoke.mjs && node scripts/connected-worker-overview-smoke.mjs && node scripts/worker-running-duration-smoke.mjs",
    "test:control-center": "node scripts/control-center-task-history-smoke.mjs",
    "test:api-worker-job-modal": "node scripts/api-worker-job-modal-smoke.mjs",
    "test:api-worker-streaming": "node scripts/api-worker-streaming-smoke.mjs",
    "test:dropdowns": "node scripts/app-dropdown-smoke.mjs",
    "test:chat-scroll": "electron scripts/chat-scroll-stability-smoke.cjs",
    "test:extension-sync": "node scripts/extension-sync-smoke.mjs",
    "test:workers": "node ../scripts/worker-plugin-smoke.mjs",
    "test:icon": "node scripts/icon-asset-smoke.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@react-sigma/core": "^5.0.6",
    "@react-sigma/layout-forceatlas2": "^5.0.6",
    "graphology": "^0.26.0",
    "katex": "^0.18.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "store.muatenmien.codexpro.manager",
    "productName": "CodexPro Manager",
    "artifactName": "CodexPro-Manager-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../chrome-extension",
        "to": "chrome-extension",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "win": {
      "icon": "../docs/favicon.svg",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodexPro Manager"
    }
  }
}
