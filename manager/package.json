{
  "name": "codexpro-manager",
  "version": "0.2.80",
  "private": true,
  "description": "Windows desktop manager for a local CodexPro MCP server.",
  "author": "CodexPro contributors",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env CODEXPRO_MANAGER_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "test:markdown": "node scripts/markdown-response-smoke.mjs",
    "test:chat-scroll": "electron scripts/chat-scroll-stability-smoke.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@react-sigma/core": "^5.0.6",
    "@react-sigma/layout-forceatlas2": "^5.0.6",
    "graphology": "^0.26.0",
    "katex": "^0.18.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "store.muatenmien.codexpro.manager",
    "productName": "CodexPro Manager",
    "artifactName": "CodexPro-Manager-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "../docs/favicon.svg",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodexPro Manager"
    }
  }
}
